<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="120dp"
    android:layout_height="180dp"
    android:layout_margin="10dp"
    style="@style/Theme.EBookReader">

    <ImageView
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/BookTitle_tv_cardview"
        android:id="@+id/BookCover_Iv_cardview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/ic_launcher_foreground"
        android:scaleType="centerCrop"
        />
    <TextView
        app:layout_constraintTop_toBottomOf="@id/BookCover_Iv_cardview"
        app:layout_constraintBottom_toTopOf="@+id/ChapterProgress_tv_cardview"
        android:id="@+id/BookTitle_tv_cardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Book Title"
        android:textSize="12sp"
        android:textColor="@color/black"
        android:gravity="center"
        />
    <TextView
        app:layout_constraintTop_toBottomOf="@id/BookTitle_tv_cardview"
        app:layout_constraintBottom_toTopOf="@+id/ReadingProgress_pb_cardview"
        android:id="@+id/ChapterProgress_tv_cardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="读到第?章/总共?章"
        android:textSize="10sp"
        android:textColor="@color/black"
        android:gravity="start"
        />

    <ProgressBar
        app:layout_constraintTop_toBottomOf="@id/ChapterProgress_tv_cardview"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/ReadingProgress_pb_cardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="50"
        android:max="100"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        />


</androidx.constraintlayout.widget.ConstraintLayout>