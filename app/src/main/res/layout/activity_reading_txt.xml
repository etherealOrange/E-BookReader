<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ReadingBook.Reading_TXT"
    android:fitsSystemWindows="true"
    app:layoutDescription="@xml/chapter_drawer_motion_scene">



    <!--    章节列表-->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:id="@+id/chapter_panel"
        android:paddingHorizontal="10dp"
        android:paddingVertical="15dp"
        >
        <com.google.android.material.button.MaterialButton
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="切换"
            android:id="@+id/test"
            android:textSize="20sp"
            />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:id="@+id/Chapter_Title"
            android:text="title"
            android:padding="10dp"
            android:textSize="20sp"
            android:maxLines="1"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/chapter_list"
            />
    </LinearLayout>

    <!--    章节内容-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/chapter_content"
        android:orientation="vertical">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:id="@+id/recyclerView"
            android:paddingHorizontal="10dp"
            android:clipToPadding="true"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="bottom"
            android:padding="10dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10dp"
                android:id="@+id/setting_reading_btn"
                android:text="设置"
                android:textSize="20sp"
                />
            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10dp"
                android:id="@+id/chapters_reading_btn"
                android:text="章节"
                android:textSize="20sp"
                />
            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10dp"
                android:id="@+id/bookmark_reading_btn"
                android:text="书签"
                android:textSize="20sp"
                />

        </LinearLayout>
    </LinearLayout>





</androidx.constraintlayout.motion.widget.MotionLayout>