<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:layout_constraintBottom_toBottomOf="parent"
    android:layout_gravity="bottom"
    android:background="@color/grey"
    >
    <Button
        android:id="@+id/SwitchToBookshelf_btn_Bookshelf_StartBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/SwitchToMySpace_btn_Bookshelf_EndBottom"
        android:layout_height="match_parent"
        android:text="@string/Main_YourBookSHelf_StartBottom_btn"
        style="@style/Bottom_btn_Switch_btn"
        />
    <Button
        android:id="@+id/SwitchToMySpace_btn_Bookshelf_EndBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/SwitchToBookshelf_btn_Bookshelf_StartBottom"
        android:text="@string/Main_YourOwnSpace_EndBottom_btn"
        android:layout_height="match_parent"
        style="@style/Bottom_btn_Switch_btn"
        />


</androidx.constraintlayout.widget.ConstraintLayout>